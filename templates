<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مكتب وكلاء الذكاء الاصطناعي التفاعلي</title>
    <style>
        body { background-color: #0f172a; color: #f8fafc; font-family: Tahoma, sans-serif; margin: 0; padding: 20px; }
        h1 { text-align: center; color: #38bdf8; margin-bottom: 5px; }
        p.subtitle { text-align: center; color: #94a3b8; margin-top: 0; }
        
        .office-container {
            display: flex;
            justify-content: space-around;
            background: #1e293b;
            border: 2px solid #334155;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            position: relative;
            min-height: 300px;
        }

        .agent-station {
            width: 45%;
            background: #0f172a;
            border: 1px solid #475569;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
        }

        .avatar {
            font-size: 40px;
            margin: 10px 0;
            transition: transform 0.5s ease;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .status-idle { background: #eab308; color: #000; }
        .status-walking { background: #3b82f6; color: #fff; }
        .status-working { background: #22c55e; color: #fff; }

        .control-panel {
            background: #1e293b;
            border: 2px solid #334155;
            border-radius: 12px;
            padding: 20px;
        }

        input, textarea, button {
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            margin-bottom: 15px;
            border-radius: 6px;
            border: 1px solid #475569;
            background: #0f172a;
            color: #fff;
            box-sizing: border-box;
        }

        button {
            background: #3b82f6;
            border: none;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }
        button:hover { background: #2563eb; }

        .logs {
            background: #020617;
            padding: 10px;
            border-radius: 6px;
            height: 120px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 13px;
            color: #38bdf8;
            text-align: left;
        }
    </style>
</head>
<body>

    <h1>نظام وكلاء الذكاء الاصطناعي المكتبي</h1>
    <p class="subtitle">نموذج Kimi K3 عبر NVIDIA NIM API</p>

    <!-- بيئة المكتب المرئية -->
    <div class="office-container">
        <!-- الوكيل الأول -->
        <div class="agent-station" id="station-1">
            <h3>الوكيل الأول (خبير الرؤية والتحليل)</h3>
            <div class="avatar" id="avatar-1">🛋️</div>
            <p>الحالة: <span class="status-badge status-idle" id="status-1">في الاستراحة</span></p>
            <div class="logs" id="log-1">في انتظار الأوامر...</div>
        </div>

        <!-- الوكيل الثاني -->
        <div class="agent-station" id="station-2">
            <h3>الوكيل الثاني (المطور والمنفذ)</h3>
            <div class="avatar" id="avatar-2">🛋️</div>
            <p>الحالة: <span class="status-badge status-idle" id="status-2">في الاستراحة</span></p>
            <div class="logs" id="log-2">في انتظار الأوامر...</div>
        </div>
    </div>

    <!-- لوحة التحكم -->
    <div class="control-panel">
        <h3>لوحة الأوامر وتوجيه الوكلاء</h3>
        <label>اختر الوكيل:</label>
        <select id="agentSelect">
            <option value="1">الوكيل الأول</option>
            <option value="2">الوكيل الثاني</option>
        </select>

        <label>أمر المهمة (Prompt):</label>
        <input type="text" id="promptInput" value="What is in this image? اشرح لي محتوى الصورة بدقة">

        <label>رابط الصورة (Image URL):</label>
        <input type="text" id="imageUrlInput" value="https://assets.ngc.nvidia.com/products/api-catalog/phi-3-5-vision/example1b.jpg">

        <button onclick="sendTaskToAgent()">إرسال الوكيل إلى الكمبيوتر وبدء التنفيذ</button>
    </div>

    <script>
        async function sendTaskToAgent() {
            const agentId = document.getElementById('agentSelect').value;
            const prompt = document.getElementById('promptInput').value;
            const imageUrl = document.getElementById('imageUrlInput').value;

            const avatar = document.getElementById(`avatar-${agentId}`);
            const statusBadge = document.getElementById(`status-${agentId}`);
            const logBox = document.getElementById(`log-${agentId}`);

            // 1. يتحرك الوكيل إلى الكمبيوتر
            avatar.innerHTML = "🚶‍♂️💻";
            statusBadge.className = "status-badge status-walking";
            statusBadge.innerText = "يمشي إلى الكمبيوتر...";
            logBox.innerHTML += `\n[تنبيه]: الوكيل ${agentId} يتحرك نحو مكتبه للعمل...`;

            setTimeout(async () => {
                // 2. يبدأ العمل
                avatar.innerHTML = "💻⚡";
                statusBadge.className = "status-badge status-working";
                statusBadge.innerText = "جاري تنفيذ المهمة...";
                logBox.innerHTML += `\n[AI]: متصل بنموذج Kimi K3 عبر السيرفر...`;

                try {
                    const response = await fetch('/api/run-agent', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ agent_id: parseInt(agentId), prompt: prompt, image_url: imageUrl })
                    });
                    
                    const data = await response.json();
                    
                    if(data.status === "success") {
                        logBox.innerHTML += `\n[النتيجة]: ${data.result}`;
                    } else {
                        logBox.innerHTML += `\n[خطأ]: ${data.message}`;
                    }
                } catch (err) {
                    logBox.innerHTML += `\n[خطأ اتصال]: ${err}`;
                }

                // 3. يخلص شغل ويرجع للاستراحة
                setTimeout(() => {
                    avatar.innerHTML = "🛋️☕";
                    statusBadge.className = "status-badge status-idle";
                    statusBadge.innerText = "في الاستراحة";
                    logBox.innerHTML += `\n[إنهاء]: انتهى العمل وعاد الوكيل للاستراحة.`;
                    logBox.scrollTop = logBox.scrollHeight;
                }, 1500);

            }, 2000);
        }
    </script>
</body>
</html>
